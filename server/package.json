{
  "name": "expoz-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('public', 'dist/public', { recursive: true })\"",
    "start": "npm run build && node dist/index.js",
    "test": "npm run build && tsx --test test/**/*.test.ts",
    "test:integration": "npm run build && tsx --test test/integration.test.ts"
  },
  "dependencies": {
    "express": "^4.18.0",
    "nanoid": "^5.0.0",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
